{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__vercel_path=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index?__vercel_path=/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
